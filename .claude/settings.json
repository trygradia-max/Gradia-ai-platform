  "permissions": {
    "deny": [
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git reset --hard*)",
      "Bash(git add -A*)",
      "Bash(git add .*)",
      "Bash(git stash pop*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git branch -D*)",
      "Bash(git checkout main*)",
      "Bash(git switch main*)",
      "Bash(gh pr merge*)",
      "Bash(vercel --prod*)",
      "Bash(vercel deploy*)",
      "Bash(supabase db push*)",
      "Bash(supabase db reset*)",
      "Bash(rm -rf*)",
      "Read(.playwright-mcp/**)",
      "Edit(.playwright-mcp/**)",
      "Edit(.env*)",
      "Read(.env.local)",
      "Bash(git push origin main*)",
      "Bash(git push * main*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(vercel env add*)",
      "Bash(vercel env rm*)",
      "Bash(vercel env pull*)"
    ],
    "allow": [
      "Bash(vercel logs*)",
      "Bash(vercel inspect*)",
