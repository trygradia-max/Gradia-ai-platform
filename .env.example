NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role — server-only. Used by the Slack interactivity route to
# resolve pending actions and insert approved rows without a user session.
SUPABASE_SERVICE_ROLE_KEY=

# Slack Incoming Webhook (server-only) — posts approval cards
SLACK_WEBHOOK_URL=
# Signing secret — verifies Approve/Edit button callbacks (server-only).
# Slack app settings → Basic Information → Signing Secret.
SLACK_SIGNING_SECRET=
# Dashboard URL referenced inside Slack messages
GRADIA_DASHBOARD_URL=http://localhost:3000/dashboard

# Anthropic Claude — Expert Roadmap / AI Lead extraction (server-only)
ANTHROPIC_API_KEY=

# OpenAI — embeddings for the shared memory layer (server-only).
# Model: text-embedding-3-small (1536 dims, baked into the interactions
# table schema — changing model requires a migration).
OPENAI_API_KEY=
