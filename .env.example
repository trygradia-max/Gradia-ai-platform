NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role — server-only. Used by webhooks, crons and the approvals
# executor to act without a user session (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Public dashboard origin — absolute links in alerts, provider callbacks and
# OAuth redirects derive from it.
GRADIA_DASHBOARD_URL=http://localhost:3000/dashboard

# Anthropic Claude — Expert Roadmap / AI Lead extraction (server-only)
ANTHROPIC_API_KEY=

# OpenAI — embeddings for the shared memory layer (server-only).
# Model: text-embedding-3-small (1536 dims, baked into the interactions
# table schema — changing model requires a migration).
OPENAI_API_KEY=

# Vapi voice receptionist (server-only).
# Account API key from the Vapi dashboard.
VAPI_API_KEY=
# Set the matching value as the "Server URL Secret" on the Vapi assistant
# so /api/vapi/webhook can verify incoming events.
VAPI_WEBHOOK_SECRET=
# Optional single-shop fallback for local dev. In production, leave this
# blank — each shop pastes their Vapi assistant ID in /settings and the
# webhook routes by that.
VAPI_DEFAULT_SHOP_ID=

# Aurinko email integration (server-only). Get these from the Aurinko
# dashboard → App settings.
AURINKO_CLIENT_ID=
AURINKO_CLIENT_SECRET=
# Signing secret for verifying inbound webhook signatures.
# Aurinko dashboard → App settings → Signing Secret.
AURINKO_SIGNING_SECRET=

# Twilio SMS (server-only). Pilot uses one global account; each shop
# pastes their owned number in /settings. Get these from the Twilio
# console → Account → API keys & tokens (or Account SID + Auth Token).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Cron auth (server-only). Vercel automatically sends
# `Authorization: Bearer <CRON_SECRET>` on scheduled invocations.
# Generate with `openssl rand -hex 32`. /api/cron/reminders fails
# closed if this is missing.
CRON_SECRET=

# Stripe — platform secret key (sk_test_... / sk_live_...). Used for BOTH the
# $20/mo subscription (MVP paywall) and the hidden Connect billing flow.
STRIPE_SECRET_KEY=
# Subscription paywall (MVP). The recurring $20/mo Price id (price_...) from
# Stripe Dashboard → Products. Required when FEATURES.paywall is on.
STRIPE_PRICE_ID=
# Voice add-on subscription Price id (price_...) — the +$29/mo Voice
# Receptionist SKU. Voice checkout 500s without it (lib/stripe.ts).
STRIPE_PRICE_VOICE_ADDON=
# One-time credit top-up pack Price id (price_...) — Core credit packs.
STRIPE_PRICE_CREDIT_PACK=
# One-time voice-minute top-up pack Price id (price_...) — minute packs.
STRIPE_PRICE_MINUTE_PACK=
# Stripe API base override — tests/staging only (mock seam). Leave unset in
# every real environment; defaults to https://api.stripe.com/v1.
STRIPE_API_BASE=
# Endpoint signing secret (whsec_...) for /api/stripe/webhook. Subscribe the
# endpoint to: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid, invoice.payment_failed,
# charge.refunded.
STRIPE_WEBHOOK_SECRET=
#
# --- Stripe Connect (HIDDEN for MVP — charges the detailer's customers) ---
# STRIPE_CONNECT_CLIENT_ID (ca_...): Dashboard → Settings → Connect → Onboarding.
STRIPE_CONNECT_CLIENT_ID=
# Publishable key (pk_...) for the embedded Connect onboarding component.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Application encryption key (server-only). Used to encrypt per-shop
# credential material at rest — currently shops.aurinko_access_token_enc
# and shops.instagram_page_access_token_enc.
# Must be 64 hex characters (32 bytes). Generate with:
#   openssl rand -hex 32
# Rotation today is manual (decrypt → set new key → re-encrypt). Treat
# this as critical: losing it means every connected shop has to
# Disconnect + Reconnect to recover.
ENCRYPTION_KEY=

# Meta Messenger Platform / Instagram DMs (HIDDEN for MVP).
# Get the App ID + App Secret from your Meta App → Settings → Basic.
# Pick any strong opaque string for the verify token — it's just the
# shared secret we hand back to Meta on the webhook subscribe handshake.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Jobber CRM (server-only). Register a Jobber developer app at
# https://developer.getjobber.com — set the redirect URL to
# https://YOUR_DOMAIN/api/jobber/auth/callback. Required scopes:
# read_clients write_clients read_requests write_requests
# read_quotes write_quotes.
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=

# Sentry error monitoring. All four together are required only when
# we want source-map upload at build time. Runtime error capture
# works with just SENTRY_DSN (server) + NEXT_PUBLIC_SENTRY_DSN
# (browser). Leave blank in dev — the SDK detects empty DSN and
# no-ops cleanly.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Platform-wide daily retail-spend ceiling in CENTS — code-side backstop to
# the vendor caps (over-usage runbook #5; lib/monitoring.ts). The anomaly
# sweep flags a global_ceiling anomaly when today's platform retail spend
# reaches it. Unset or 0 disables the check.
GLOBAL_DAILY_COST_CEILING_CENTS=

# P0-004 conflict enforcement rollout flag. OFF unless set to exactly
# "true" — false, missing, or malformed values disable it (all booking/
# reschedule/block-time paths then behave exactly as before P0-004).
# Set per-environment in Vercel (e.g. Preview "true", Production "false").
# NEXT_PUBLIC_* values are inlined at build time: changing this in Vercel
# takes effect only on the next deployment.
NEXT_PUBLIC_GRADIA_CONFLICT_ENFORCEMENT=

# Founder ops alerts (P0-012, D-042). Server-only. The single delivery seam
# (src/lib/alerts.ts) for usage anomalies, tenant-scope violations,
# reconciliation drift and cron failures. Leave ALL blank to keep the
# pre-P0-012 behavior (console + Sentry only); /api/health then reports
# "unconfigured". Never log these values.
# JSON webhook that accepts { text } — the founder Slack ops channel's
# incoming-webhook URL. Every severity goes here.
OPS_ALERT_WEBHOOK_URL=
# SEV-0 / SEV-1 also go by SMS via the env Twilio master account when BOTH
# are set (E.164). Optional.
OPS_ALERT_SMS_TO=
OPS_ALERT_SMS_FROM=
